{
  "name": "mathverse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --noEmit",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode singlefile",
    "release": "npm run build:single && node -e \"require('fs').copyFileSync('dist-single/index.html','mathverse-single-file.html')\"",
    "lint": "oxlint",
    "preview": "vite preview",
    "verify": "tsx scripts/verifyProblems.ts && tsx scripts/verifyRejects.ts && tsx scripts/verifyLatexInput.ts",
    "verify:independent": "tsx scripts/independentVerify.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "autoprefixer": "^10.6.2",
    "katex": "^0.19.1",
    "mathjs": "^15.2.0",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^4.1.12"
  }
}
